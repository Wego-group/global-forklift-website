---
import Layout from "@layouts/Layout.astro";
import { languages, type Lang } from "@data/languages";
import { languagePath } from "@lib/seo";
import { getNewsArticles, getNewsForLanguage } from "@lib/news";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = Astro.params.lang as Lang;
const articles = getNewsForLanguage(await getNewsArticles(), lang);
---

<Layout lang={lang} title={`News | WEGO Forklift`} description="WEGO company updates, product guides, technical notes, and export-related forklift articles." path="/news/">
  <main>
    <header class="page-header">
      <div class="container">
        <span class="eyebrow">News</span>
        <h1 class="section-title">News and technical articles</h1>
        <p class="lead">WEGO company updates, product guides, technical notes, and export-related forklift articles.</p>
      </div>
    </header>
    <section class="section">
      <div class="container">
        <div class="news-list">
          {
            articles.map((article) => (
              <article class="news-row">
                {article.cover && (
                  <a class="news-row-media" href={languagePath(lang, `/news/${article.slug}/`)}>
                    <img src={article.cover} alt={article.coverAlt} width="960" height="540" loading="lazy" />
                  </a>
                )}
                <div class="news-row-body">
                  <p class="card-meta">{article.publishedAt.slice(0, 10)}</p>
                  <h2><a href={languagePath(lang, `/news/${article.slug}/`)}>{article.title}</a></h2>
                  <p>{article.excerpt}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
