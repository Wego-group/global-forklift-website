{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.wegoforklift.com" }
      ],
      "destination": "https://wegoforklift.com/:path",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:lang/parts-service/:path*",
      "destination": "/:lang/service/",
      "permanent": true
    },
    {
      "source": "/:lang/services/",
      "destination": "/:lang/service/",
      "permanent": true
    },
    {
      "source": "/:lang/why-wego/:path*",
      "destination": "/:lang/about/",
      "permanent": true
    },
    {
      "source": "/:lang/resources/:path*",
      "destination": "/:lang/news/",
      "permanent": true
    },
    {
      "source": "/:lang/industries/:path*",
      "destination": "/:lang/solutions/:path/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/feeds/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
