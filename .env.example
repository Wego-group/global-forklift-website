# Change this to the production domain before indexing or building a sitemap.
PUBLIC_SITE_URL=https://wegoforklift.com

# Keep this false until real product copy, images, certifications, and policies are ready.
PUBLIC_ALLOW_INDEXING=false

# Public Sanity project details used to build the SEO-friendly News pages.
# These values are safe to expose because the dataset is read-only from the website.
PUBLIC_SANITY_PROJECT_ID=oingo0yd
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-07-27

# WxPusher SPT for one-to-one inquiry alerts and the daily traffic report.
# Store this only in Netlify environment variables. Never commit a real SPT.
WXPUSHER_SPT=

# Legacy/alternative CRM route. It is ignored whenever PUSHPLUS_TOKEN is configured.
# If no delivery route is configured, the form opens a prefilled email draft.
LEAD_WEBHOOK_URL=
LEAD_EMAIL=sales@cnwegogroup.com
